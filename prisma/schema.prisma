generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------
// NOVA tabela: usuarios para login na nossa API (JWT).
// Nao tem relacao com auth.users do Supabase.
// ---------------------------------------------------------------
model usuarios_api {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nome          String
  email         String   @unique
  senha_hash    String
  criado_em     DateTime @default(now()) @db.Timestamptz(6)
  atualizado_em DateTime @default(now()) @updatedAt @db.Timestamptz(6)
}

// ---------------------------------------------------------------
// Tabelas que JA existiam (vindas do db pull)
// ---------------------------------------------------------------
model clientes {
  id         String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  usuario_id String       @default(dbgenerated("auth.uid()")) @db.Uuid
  nome       String
  telefone   String?
  criado_em  DateTime     @default(now()) @db.Timestamptz(6)
  pagamentos pagamentos[]
  vendas     vendas[]

  @@unique([id, usuario_id])
  @@index([usuario_id])
}

model despesas {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  usuario_id   String   @default(dbgenerated("auth.uid()")) @db.Uuid
  descricao    String
  valor        Decimal  @db.Decimal(12, 2)
  data_despesa DateTime @default(dbgenerated("CURRENT_DATE")) @db.Date

  @@index([usuario_id, data_despesa(sort: Desc)])
}

model entradas_estoque {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  usuario_id   String   @default(dbgenerated("auth.uid()")) @db.Uuid
  produto_id   String   @db.Uuid
  quantidade   Decimal  @db.Decimal(12, 3)
  observacao   String?
  data_entrada DateTime @default(now()) @db.Timestamptz(6)
  produtos     produtos @relation(fields: [produto_id, usuario_id], references: [id, usuario_id], onDelete: NoAction, onUpdate: NoAction)

  @@index([produto_id])
  @@index([usuario_id, data_entrada(sort: Desc)])
}

model itens_venda {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  usuario_id     String   @db.Uuid
  venda_id       String   @db.Uuid
  produto_id     String   @db.Uuid
  quantidade     Decimal  @db.Decimal(12, 3)
  preco_unitario Decimal  @db.Decimal(12, 2)
  custo_unitario Decimal  @db.Decimal(12, 2)
  subtotal       Decimal? @default(dbgenerated("round((quantidade * preco_unitario), 2)")) @db.Decimal(12, 2)
  produtos       produtos @relation(fields: [produto_id, usuario_id], references: [id, usuario_id], onDelete: NoAction, onUpdate: NoAction)
  vendas         vendas   @relation(fields: [venda_id, usuario_id], references: [id, usuario_id], onDelete: Cascade, onUpdate: NoAction)

  @@index([produto_id])
  @@index([venda_id])
}

model pagamentos {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  usuario_id     String   @default(dbgenerated("auth.uid()")) @db.Uuid
  cliente_id     String   @db.Uuid
  valor          Decimal  @db.Decimal(12, 2)
  data_pagamento DateTime @default(now()) @db.Timestamptz(6)
  clientes       clientes @relation(fields: [cliente_id, usuario_id], references: [id, usuario_id], onDelete: NoAction, onUpdate: NoAction)

  @@index([cliente_id])
}

model produtos {
  id                 String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  usuario_id         String             @default(dbgenerated("auth.uid()")) @db.Uuid
  nome               String
  preco_custo        Decimal            @db.Decimal(12, 2)
  preco_venda        Decimal            @db.Decimal(12, 2)
  quantidade_estoque Decimal            @default(0) @db.Decimal(12, 3)
  estoque_minimo     Decimal            @default(0) @db.Decimal(12, 3)
  ativo              Boolean            @default(true)
  criado_em          DateTime           @default(now()) @db.Timestamptz(6)
  entradas_estoque   entradas_estoque[]
  itens_venda        itens_venda[]

  @@unique([id, usuario_id])
  @@index([usuario_id, ativo])
}

model vendas {
  id              String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  usuario_id      String          @default(dbgenerated("auth.uid()")) @db.Uuid
  cliente_id      String?         @db.Uuid
  forma_pagamento forma_pagamento
  total           Decimal         @default(0) @db.Decimal(12, 2)
  lucro           Decimal         @default(0) @db.Decimal(12, 2)
  data_venda      DateTime        @default(now()) @db.Timestamptz(6)
  itens_venda     itens_venda[]
  clientes        clientes?       @relation(fields: [cliente_id, usuario_id], references: [id, usuario_id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([id, usuario_id])
  @@index([usuario_id, data_venda(sort: Desc)])
}

enum forma_pagamento {
  a_vista
  fiado
}
